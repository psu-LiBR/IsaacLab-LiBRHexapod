**/tactile_record/*
**/gelsight_r15_data/*

# sim2real_transfer: real (calibrated) deployment config and staged policy
# checkpoints are per-robot/per-run, not tracked -- only the .example.yaml is.
scripts/sim2real_transfer/config/deployment.yaml
scripts/sim2real_transfer/policies/

# No benchmarks output
/benchmarks/

# Ruff cache
**/.ruff_cache/

# Isaac Lab CI environments in native mode
